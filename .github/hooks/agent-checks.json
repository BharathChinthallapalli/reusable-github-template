{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "type": "command",
        "bash": "python3 hooks/run_hook.py --event session",
        "powershell": "py -3 hooks/run_hook.py --event session",
        "cwd": ".",
        "timeoutSec": 180
      }
    ],
    "preToolUse": [
      {
        "type": "command",
        "bash": "python3 hooks/run_hook.py --event pre",
        "powershell": "py -3 hooks/run_hook.py --event pre",
        "cwd": ".",
        "timeoutSec": 30
      }
    ],
    "postToolUse": [
      {
        "type": "command",
        "bash": "python3 hooks/run_hook.py --event post",
        "powershell": "py -3 hooks/run_hook.py --event post",
        "cwd": ".",
        "timeoutSec": 30
      }
    ]
  }
}
